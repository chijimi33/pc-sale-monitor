        "/t/c/\\d+/",
        "/special/"
      ],
      "default_condition": "new",
      "pc_only": true
    },
    "tsukumo": {
      "name": "ツクモ",
      "adapter": "html",
      "seed_urls": [
        "https://shop.tsukumo.co.jp/"
